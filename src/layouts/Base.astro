---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactDialog from '../components/ContactDialog.astro';
import { SITE } from '../data/site';
import { graph, personNode, websiteNode, webPageNode } from '../lib/schema';
import { LANG_TAG, OG_LOCALE, type Locale } from '../lib/markets';
import { t } from '../i18n/ui';
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/corporate-events". Canonical is built from SITE.url. */
  path: string;
  ogImage?: string;
  noindex?: boolean;
  /** Extra JSON-LD nodes merged into this page’s @graph. */
  schema?: object[];
  /** Adds a subtle top rule under the nav on inner pages. */
  bodyClass?: string;
  /** Page language. Sets <html lang>, og:locale and the draft banner text. */
  locale?: Locale;
  /**
   * hreflang set from lib/markets alternates(): every live sibling plus
   * x-default. Also drives the nav's language switcher. Empty = no siblings.
   */
  alternates?: { hreflang: string; href: string; locale: Locale }[];
  /** Unreviewed translation: noindex plus a visible reviewer banner. */
  draft?: boolean;
  /** YYYY-MM-DD the page content last changed, when known (market pages). */
  modified?: string;
}

const {
  title,
  description,
  path,
  ogImage = SITE.defaultOgImage,
  noindex = false,
  schema = [],
  bodyClass = '',
  locale = 'en',
  alternates = [],
  draft = false,
  modified,
} = Astro.props;
const robotsNoindex = noindex || draft;
const ogAlternates = alternates.filter((a) => a.hreflang !== 'x-default' && a.locale !== locale);

const canonical = `${SITE.url}${path === '/' ? '/' : path}`;
const ogUrl = new URL(ogImage, SITE.url).href;
const ld = graph([
  personNode(),
  websiteNode(),
  webPageNode({ path, title, description, inLanguage: LANG_TAG[locale], image: ogUrl, dateModified: modified }),
  ...schema,
]);
const ga4 = import.meta.env.PUBLIC_GA4_ID;
---

<!doctype html>
<html lang={LANG_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robotsNoindex && <meta name="robots" content="noindex, nofollow" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- Display face used by the h1 on every page. Preloaded to kill the FOUT. -->
    <link
      rel="preload"
      href="/fonts/bodoni-moda-latin-opsz-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {ogAlternates.map((a) => <meta property="og:locale:alternate" content={OG_LOCALE[a.locale]} />)}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="theme-color" content="#0a1013" />
    <link rel="icon" href="/logo/seal.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline type="application/ld+json" set:html={ld} />

    {
      ga4 && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
          <script is:inline define:vars={{ ga4 }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', ga4);
          </script>
        </>
      )
    }
    {/* Cookieless page views and the lead event; no-ops outside Vercel. */}
    <Analytics />
  </head>

  <body class={bodyClass}>
    <a class="skip" href="#main">{{ en: 'Skip to content', 'pt-br': 'Pular para o conteúdo', fr: 'Aller au contenu' }[locale]}</a>
    <Nav alternates={alternates} locale={locale} />
    {draft && <p class="draftbar" role="note">{t(locale).draftBanner}</p>}
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    {/* The "send a message" modal is English-only; translated pages keep the
        in-page form and plain mailto links instead. */}
    {locale === 'en' && <ContactDialog />}
    <script>
      import { initMotion } from '../lib/motion';
      import { protectImages } from '../lib/protectImages';
      import { contactDialog } from '../lib/contactDialog';
      import { photoLightbox } from '../lib/videoLightbox';
      import { recordFirstTouch } from '../lib/firstTouch';
      recordFirstTouch();
      initMotion();
      protectImages();
      contactDialog();
      photoLightbox();
    </script>
  </body>
</html>
