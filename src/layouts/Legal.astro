---
import Base from './Base.astro';
import { breadcrumbNode } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  updated: string;
}
const { title, description, path, heading, updated } = Astro.props;
---

<Base
  title={title}
  description={description}
  path={path}
  schema={[breadcrumbNode([{ name: 'Home', path: '/' }, { name: heading, path }])]}
>
  <section class="section tight">
    <div class="wrap legal">
      <h1>{heading}</h1>
      <p class="small muted updated">Last updated {updated}</p>
      <div class="prose body">
        <slot />
      </div>
    </div>
  </section>
</Base>

<style>
  .legal { max-width: 820px; }
  h1 { font-size: clamp(38px, 5vw, 62px); margin-bottom: 14px; }
  .updated { margin-bottom: 40px; }

  .body :global(h2) {
    font-size: 26px;
    margin: 40px 0 14px;
  }
  .body :global(h2:first-child) { margin-top: 0; }
  .body :global(p) { max-width: none; }
  .body :global(ul) { margin: 12px 0 12px 20px; }
  .body :global(li) { margin-bottom: 8px; }
  .body :global(a) { color: var(--tan); text-decoration: underline; text-underline-offset: 3px; }
</style>
