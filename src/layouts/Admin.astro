---
import '../styles/global.css';

/**
 * Shell for /admin: the site's fonts and colours, none of its nav, footer,
 * analytics or schema. Never indexed, never cached.
 */
export interface Props {
  title: string;
  signedIn?: boolean;
}
const { title, signedIn = false } = Astro.props;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · DEEJAY T-JR. site editor</title>
  </head>
  <body class="admin">
    <header class="bar">
      <div class="wrap row">
        <a class="brand" href="/admin">DEEJAY T-JR. <span>· site editor</span></a>
        {
          signedIn && (
            <nav class="small">
              <a href="/" target="_blank" rel="noopener">View site ↗</a>
              <form method="post" action="/admin">
                <input type="hidden" name="action" value="logout" />
                <button type="submit" class="linkbtn">Sign out</button>
              </form>
            </nav>
          )
        }
      </div>
    </header>
    <main class="wrap main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body.admin { background: var(--ink); color: var(--body); min-height: 100vh; }
  .admin .bar { border-bottom: 1px solid var(--hairline); padding-block: 18px; }
  .admin .row { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .admin .brand { font-family: var(--serif); font-size: 22px; color: var(--bone); }
  .admin .brand span { color: var(--muted); font-size: 16px; }
  .admin .bar nav { display: flex; gap: 20px; align-items: center; }
  .admin .bar nav a, .admin .linkbtn { color: var(--muted); background: none; border: 0; cursor: pointer; font: inherit; padding: 0; }
  .admin .bar nav a:hover, .admin .linkbtn:hover { color: var(--tan); }
  .admin .main { padding-block: clamp(32px, 5vw, 56px) 80px; max-width: 860px; }
  .admin h1 { font-size: clamp(32px, 5vw, 44px); margin-bottom: 10px; }
  .admin .intro { color: var(--muted); margin-bottom: 28px; max-width: 40em; }
  .admin .crumbs { margin-bottom: 18px; }
  .admin .crumbs a { color: var(--muted); }
  .admin .crumbs a:hover { color: var(--tan); }
  .admin .notice { border: 1px solid var(--tan); color: var(--bone); padding: 14px 18px; margin-bottom: 28px; }
  .admin .notice.bad { border-color: #d9826b; }
  .admin .list { list-style: none; border-top: 1px solid var(--hairline); }
  .admin .list li { border-bottom: 1px solid var(--hairline); }
  .admin .list a { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding: 16px 4px; }
  .admin .list a:hover .t { color: var(--tan); }
  .admin .list .t { color: var(--bone); font-size: 17px; }
  .admin .list .s { color: var(--muted); font-size: 14px; }
  .admin .list .go { color: var(--muted); flex: none; }
  .admin .top { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .admin .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 22px; }
  .admin label.l { color: var(--bone); font-size: 15px; }
  .admin .help { color: var(--muted); font-size: 13.5px; }
  .admin .err { color: #e6a08e; font-size: 13.5px; }
  .admin input[type='text'], .admin input[type='url'], .admin input[type='number'], .admin input[type='password'], .admin textarea, .admin select {
    width: 100%; background: var(--panel); color: var(--bone); border: 1px solid var(--hairline); padding: 12px 14px; font: inherit; font-size: 16px;
  }
  .admin textarea { min-height: 120px; resize: vertical; }
  .admin input:focus, .admin textarea:focus, .admin select:focus { outline: 2px solid var(--tan); outline-offset: 1px; }
  .admin .check { display: flex; gap: 10px; align-items: flex-start; color: var(--bone); }
  .admin .check input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--tan); }
  .admin fieldset.field { border: 0; padding: 0; margin: 0 0 22px; min-width: 0; }
  .admin fieldset.field legend { margin-bottom: 10px; padding: 0; }
  .admin .multi { display: flex; flex-direction: column; gap: 8px; }
  .admin .actions { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin-top: 30px; }
  .admin .danger { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--hairline); }
  .admin .danger button { background: none; border: 1px solid #d9826b; color: #e6a08e; padding: 10px 16px; cursor: pointer; font: inherit; }
  .admin .cards { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); }
  .admin .cards a { display: flex; flex-direction: column; gap: 6px; padding: 22px; background: var(--ink); height: 100%; }
  .admin .cards a:hover b { color: var(--tan); }
  .admin .cards b { font-family: var(--serif); font-size: 22px; color: var(--bone); font-weight: 600; }
  .admin .cards li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (max-width: 620px) { .admin .cards { grid-template-columns: 1fr; } }
</style>
