---
import Base from './Base.astro';
import Hero from '../components/Hero.astro';
import CredentialsStrip from '../components/CredentialsStrip.astro';
import SectionHead from '../components/SectionHead.astro';
import Testimonials from '../components/Testimonials.astro';
import { getTestimonials } from '../lib/testimonials';
import Faq from '../components/Faq.astro';
import AvailabilityForm from '../components/AvailabilityForm.astro';
import { getCollection } from 'astro:content';
import type { FaqItem } from '../data/faqs';
import { faqNode, serviceNode, breadcrumbNode } from '../lib/schema';
import { SITE } from '../data/site';
import type { PhotoKey } from '../data/photos';

/**
 * The eight-block service skeleton from section 6. All four service pages use
 * it; everything that differs between them arrives as a prop.
 */
export interface Props {
  title: string;
  description: string;
  path: string;
  /** Machine key: drives form pre-selection, testimonial filtering, event filtering. */
  type: 'corporate' | 'private' | 'club' | 'brand';
  serviceName: string;
  serviceType: string;
  areaServed?: string[];

  headline: string;
  lede: string;
  /** Photo registry key. */
  heroPhoto: PhotoKey;

  proof: { stat: string; detail: string }[];

  formatsTitle: string;
  formatsLede: string;
  formats: { title: string; body: string }[];

  eventsTitle: string;
  eventsLede: string;

  faq: FaqItem[];
  faqTitle: string;

  related: { label: string; href: string; note: string }[];

  /** Breadcrumb parents between Home and this page, e.g. Corporate events. */
  parents?: { name: string; path: string }[];
  /** Lead tag for the form (Canada spec: Canadian pages carry market "canada"). */
  market?: string;
  /** Form heading, when the page wants its own. */
  formHeading?: string;
  /** YYYY-MM-DD the page content last changed. */
  modified?: string;
  /** Extra JSON-LD nodes, e.g. VideoObject for a video on the page. */
  extraSchema?: object[];
}

const {
  title,
  description,
  path,
  type,
  serviceName,
  serviceType,
  areaServed,
  headline,
  lede,
  heroPhoto,
  proof,
  formatsTitle,
  formatsLede,
  formats,
  eventsTitle,
  eventsLede,
  faq,
  faqTitle,
  related,
  parents = [],
  market = '',
  formHeading,
  modified,
  extraSchema = [],
} = Astro.props;

const events = (await getCollection('events')).filter((e) => e.data.type === type);

const schema = [
  serviceNode({
    name: serviceName,
    description,
    url: `${SITE.url}${path}`,
    serviceType,
    areaServed,
  }),
  faqNode(faq),
  breadcrumbNode([
    { name: 'Home', path: '/' },
    ...parents,
    { name: serviceName, path },
  ]),
  ...extraSchema,
];

/* Decides whether the quotes section exists at all. Same permission rule the
   component applies, from the one place that owns it. */
const hasTestimonials = (await getTestimonials(type)).length > 0;
---

<Base title={title} description={description} path={path} schema={schema} modified={modified}>
  <Hero
    compact
    headline={headline}
    lede={lede}
    secondary={{ label: 'Watch her play', href: '/watch' }}
    note="Based in Toronto. Travels worldwide."
    photo={heroPhoto}
  />

  <CredentialsStrip items={proof} label="Proof" />

  <section class="section tan">
    <div class="wrap">
      <SectionHead title={formatsTitle} lede={formatsLede} />
      <div class={`hgrid cols-${formats.length >= 4 ? '4' : '3'}`} data-reveal-group>
        {
          formats.map((f) => (
            <div class="format spot">
              <h3>{f.title}</h3>
              <p class="prose small">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Escape hatch for page-specific blocks, e.g. the brand media kit. -->
  <slot name="after-formats" />

  {
    /* Named past events when we have them. When we do not, the page either
       supplies its own block (slot "no-events") or the section is left out:
       a "pending" placeholder on a sales page advertises the gap. */
    events.length > 0 ? (
      <section class="section panel">
        <div class="wrap">
          <SectionHead title={eventsTitle} lede={eventsLede} />
          <ul class="events" data-reveal-group>
            {events.map((e) => (
              <li>
                <div class="ev-copy">
                  <h3>{e.data.permissionOnFile ? e.data.client : e.data.name}</h3>
                  <p class="small muted">
                    {e.data.city} · {e.data.year}
                    {e.data.venue ? ` · ${e.data.venue}` : ''}
                  </p>
                  {e.data.note && <p class="small prose">{e.data.note}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : (
      <slot name="no-events" />
    )
  }

  {
    /* No publishable quotes yet, so the section does not appear. A heading over
       an empty box advertises the gap; absence does not. */
    hasTestimonials && (
      <section class="section tight">
        <div class="wrap">
          <SectionHead
            title="What clients say."
            lede="Quotes are published only with written permission from the person who gave them."
          />
          <Testimonials service={type} />
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <SectionHead title={faqTitle} />
      <Faq items={faq} />
    </div>
  </section>

  <slot name="before-faq-form" />

  <AvailabilityForm defaultType={type} market={market} marketName={market === 'canada' ? 'Canada' : ''} {...(formHeading ? { heading: formHeading } : {})} />

  <section class="section tight ruled">
    <div class="wrap">
      <SectionHead title="Also worth a look." as="h2" />
      <div class="hgrid cols-3" data-reveal-group>
        {
          related.map((r) => (
            <a class="rel spot" href={r.href}>
              <h3>{r.label}</h3>
              <p class="small muted">{r.note}</p>
              <span class="tlink">
                Open <span class="arw" aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .format { padding: clamp(24px, 2.8vw, 34px); }
  .format h3 {
    font-size: 21px;
    margin-bottom: 12px;
    text-wrap: balance;
    transition: color var(--t-hover) var(--ease-out);
  }
  .format:hover h3 { color: var(--tan); }

  .events { list-style: none; display: flex; flex-direction: column; gap: 1px; }
  .events li {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: center;
    padding: 26px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .events li:first-child { border-top: 1px solid var(--hairline); }
  .ev-copy h3 { font-size: 24px; margin-bottom: 6px; }
  .ev-copy p + p { margin-top: 8px; }
  .pending { color: color-mix(in srgb, var(--tan) 35%, transparent); font-style: italic; }

  .rel {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(24px, 2.8vw, 34px);
    transition: background var(--t-hover) var(--ease-out);
  }
  .rel:hover { background: var(--panel-hover); }
  .rel h3 { transition: color var(--t-hover) var(--ease-out); }
  .rel:hover h3 { color: var(--tan); }
  .rel h3 { font-size: 21px; }
  .rel p { flex-grow: 1; }
  .rel:hover .tlink { border-color: var(--tan); color: var(--tan-lift); }
  .rel:hover .arw { transform: translateX(3px); }

  @media (max-width: 820px) {
    .events li { grid-template-columns: 1fr; gap: 18px; }
  }
</style>
