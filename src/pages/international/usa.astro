---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Kpi from '../../components/Kpi.astro';
import Faq from '../../components/Faq.astro';
import AvailabilityForm from '../../components/AvailabilityForm.astro';
import { faqNode, breadcrumbNode, serviceNode } from '../../lib/schema';
import { SITE } from '../../data/site';

/**
 * Her strongest market. Cities are ordered by her audience data (section 9),
 * not by population — Houston leads because her followers do.
 */
const cities = [
  { name: 'Houston', note: 'Her single strongest US city by audience share.' },
  { name: 'Dallas', note: 'Corporate and private demand, direct from Toronto.' },
  { name: 'Austin', note: 'Festival and brand activation market.' },
  { name: 'San Antonio', note: 'Growing audience, routed with Houston and Austin.' },
  { name: 'New York', note: 'Corporate, club and brand work.' },
  { name: 'Los Angeles', note: 'Brand, showcase and club dates.' },
  { name: 'Chicago', note: 'Corporate and club bookings.' },
  { name: 'Miami', note: 'Club and festival season.' },
  { name: 'Las Vegas', note: 'Conference and trade show work.' },
];

const USA_FAQ = [
  {
    q: 'Can she legally perform in the United States?',
    a: '<p>Yes. She is a Canadian citizen and we handle US work authorisation for each engagement. Allow six to eight weeks of lead time to be comfortable; faster is often possible but should not be the plan.</p>',
  },
  {
    q: 'What does it cost to bring her from Toronto?',
    a: '<p>The performance fee plus travel. Toronto Pearson flies direct to every city on this page, so travel is usually a same-day flight plus two nights of accommodation. Your quote itemises all of it, so you see the landed cost rather than a fee and then surprises.</p>',
  },
  {
    q: 'Will we be quoted in US dollars?',
    a: '<p>Yes for US dates, unless you would rather be quoted in Canadian dollars. Say which in your enquiry.</p>',
  },
  {
    q: 'Does she have a following in our city?',
    a: '<p>The United States is her largest audience by country, led by Houston, Dallas and Austin. Ask about your specific market and we will send the actual numbers rather than a guess.</p>',
  },
  {
    q: 'Can she do a run of dates rather than one?',
    a: '<p>Yes, and it is usually better value. Routing two or three dates across Texas, or a coast, spreads the travel cost across the run. If you are working with other promoters, say so and we will help you route it.</p>',
  },
];

const reach = [
  { figure: 'Largest market', label: 'The United States is her biggest audience by country' },
  { figure: 'Texas leads', label: 'Houston, Dallas, Austin and San Antonio' },
  { figure: 'Direct from YYZ', label: 'Same-day travel to every city on this page' },
  { figure: '6 to 8 weeks', label: 'Typical lead time for work authorisation' },
];
---

<Base
  title="Book DEEJAY T-JR. in the USA | 3x DMC Canadian Champion DJ"
  description="Book DEEJAY T-JR. for corporate, private, club and festival dates across the United States. Three-time DMC Canadian Champion, travelling direct from Toronto to Houston, Dallas, Austin, New York, Los Angeles, Chicago, Miami and Las Vegas."
  path="/international/usa"
  schema={[
    serviceNode({
      name: 'DJ booking in the United States',
      description:
        'Corporate, private, club and festival DJ bookings across the United States by three-time DMC Canadian Champion DEEJAY T-JR., travelling from Toronto.',
      url: `${SITE.url}/international/usa`,
      serviceType: 'DJ performance',
      areaServed: ['United States'],
    }),
    faqNode(USA_FAQ),
    breadcrumbNode([
      { name: 'Home', path: '/' },
      { name: 'International', path: '/international' },
      { name: 'United States', path: '/international/usa' },
    ]),
  ]}
>
  <Hero
    compact
    headline="Her biggest audience is <em>American</em>."
    lede="More of her followers are in the United States than anywhere else, led by Houston, Dallas and Austin. Toronto Pearson flies direct to every market on this page, which makes a US date logistically simpler than most promoters expect."
    photo="club-set"
    note="Quoted in USD. Travelling from Toronto."
  />

  <section class="section tight">
    <div class="wrap">
      <SectionHead
        title="Why a US date is straightforward."
        lede="The hard parts — authorisation, routing, cost transparency — are handled by us, not by you."
      />
      <Kpi items={reach} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead
        title="Cities."
        lede="Ordered by her audience share, not by population. Ask about any city not listed; the list is where the demand is, not where she will go."
      />
      <ul class="cities" data-reveal-group>
        {
          cities.map((c) => (
            <li class="spot">
              <b>{c.name}</b>
              <span class="small muted">{c.note}</span>
            </li>
          ))
        }
      </ul>
      <p class="small muted note">
        Dedicated city pages are Phase 2. Until then, name your city in the form below and we will answer with availability and what she draws there.
      </p>
    </div>
  </section>

  <section class="section panel">
    <div class="wrap">
      <SectionHead title="What US bookers ask." />
      <Faq items={USA_FAQ} />
    </div>
  </section>

  <AvailabilityForm
    heading="Check a US date."
    lede="Name the city and the date. You will have availability, a USD quote and the authorisation timeline within one business day."
  />
</Base>

<style>
  .cities {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }
  .cities li {
    background: var(--ink);
    padding: clamp(20px, 2.4vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .cities b {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 600;
    color: var(--bone);
    transition: color var(--t-hover) var(--ease-out);
  }
  .cities li:hover b { color: var(--tan); }
  .note { margin-top: 26px; max-width: 40em; }

  @media (max-width: 820px) { .cities { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .cities { grid-template-columns: 1fr; } }
</style>
