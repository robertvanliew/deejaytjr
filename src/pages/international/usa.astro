---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Kpi from '../../components/Kpi.astro';
import Faq from '../../components/Faq.astro';
import AvailabilityForm from '../../components/AvailabilityForm.astro';
import { faqNode, breadcrumbNode, serviceNode } from '../../lib/schema';
import { SITE } from '../../data/site';
import { liveHref, currencyRule } from '../../lib/markets';

/**
 * Her strongest market. Every city here is in her own audience data (Houston,
 * Dallas, Austin, San Antonio and Chicago from TikTok; New York and Los
 * Angeles from Instagram). Cities with a live page link to it; the rest are
 * plain text until a page with a real local fact exists.
 */
const cities = [
  { key: 'houston', name: 'Houston', note: 'One of her top audience cities on TikTok.' },
  { key: 'dallas', name: 'Dallas', note: 'One of her top audience cities on TikTok.' },
  { key: 'austin', name: 'Austin', note: 'One of her top audience cities on TikTok.' },
  { key: 'new-york', name: 'New York', note: 'One of her top audience cities on Instagram.' },
  { key: 'san-antonio', name: 'San Antonio', note: 'In her TikTok audience data.' },
  { key: 'los-angeles', name: 'Los Angeles', note: 'In her Instagram audience data.' },
  { key: 'chicago', name: 'Chicago', note: 'In her TikTok audience data.' },
].map((c) => ({ ...c, href: liveHref(c.key, 'en') }));

const USA_FAQ = [
  {
    q: 'Can she legally perform in the United States?',
    a: '<p>Yes. She is a Canadian citizen and we handle US work authorisation for each engagement. Allow six to eight weeks of lead time to be comfortable; faster is often possible but should not be the plan.</p>',
  },
  {
    q: 'What does it cost to bring her from Toronto?',
    a: '<p>The performance fee plus travel. Toronto Pearson flies direct to most of the cities on this page, so travel is usually a same-day flight plus two nights of accommodation. Your quote itemises all of it, so you see the landed cost rather than a fee and then surprises.</p>',
  },
  {
    q: 'Will we be quoted in US dollars?',
    a: '<p>Yes. US dates are quoted in US dollars.</p>',
  },
  {
    q: 'Does she have a following in our city?',
    a: '<p>The United States is her largest audience by country, led by Houston, Dallas and Austin. Ask about your specific market and we will send the actual numbers rather than a guess.</p>',
  },
  {
    q: 'Can she do a run of dates rather than one?',
    a: '<p>Yes, and it is usually better value. Routing two or three dates across Texas, or a coast, spreads the travel cost across the run. If you are working with other promoters, say so and we will help you route it.</p>',
  },
];

const reach = [
  { figure: 'Largest market', label: 'The United States is her biggest audience by country' },
  { figure: 'Texas leads', label: 'Houston, Dallas, Austin and San Antonio' },
  { figure: 'Direct from YYZ', label: 'To Houston, Dallas, New York, Chicago and Los Angeles' },
  { figure: '6 to 8 weeks', label: 'Typical lead time for work authorisation' },
];
---

<Base
  title="Book DEEJAY T-JR. in the USA | 3x DMC Canadian Champion DJ"
  description="Book DEEJAY T-JR. for corporate, private, club and festival dates across the United States. Three-time DMC Canadian Champion, travelling from Toronto. Her biggest audience is American, led by Houston, Dallas, Austin and New York. Quoted in USD."
  path="/international/usa"
  schema={[
    serviceNode({
      name: 'DJ booking in the United States',
      description:
        'Corporate, private, club and festival DJ bookings across the United States by three-time DMC Canadian Champion DEEJAY T-JR., travelling from Toronto.',
      url: `${SITE.url}/international/usa`,
      serviceType: 'DJ performance',
      areaServed: ['United States'],
    }),
    faqNode(USA_FAQ),
    breadcrumbNode([
      { name: 'Home', path: '/' },
      { name: 'International', path: '/international' },
      { name: 'United States', path: '/international/usa' },
    ]),
  ]}
>
  <Hero
    compact
    headline="Her biggest audience is <em>American</em>."
    lede="More of her followers are in the United States than anywhere else, led by Houston, Dallas and Austin. Toronto Pearson flies direct to most of these cities, which makes a US date logistically simpler than most promoters expect."
    photo="club-set"
    note="Quoted in USD. Travelling from Toronto."
  />

  <section class="section tight">
    <div class="wrap">
      <SectionHead
        title="Why a US date is straightforward."
        lede="The hard parts — authorisation, routing, cost transparency — are handled by us, not by you."
      />
      <Kpi items={reach} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead
        title="Cities."
        lede="Ordered by her audience share, not by population. Ask about any city not listed; the list is where the demand is, not where she will go."
      />
      <ul class="cities" data-reveal-group>
        {
          cities.map((c) => (
            <li class="spot">
              {c.href ? (
                <a class="clink" href={c.href}>
                  <b>{c.name}</b>
                  <span class="small muted">{c.note}</span>
                  <span class="tlink">Open <span class="arw" aria-hidden="true">→</span></span>
                </a>
              ) : (
                <>
                  <b>{c.name}</b>
                  <span class="small muted">{c.note}</span>
                </>
              )}
            </li>
          ))
        }
      </ul>
      <p class="small muted note">
        Not listed? Name your city in the form below and we will answer with availability and what she draws there. {currencyRule('en')}
      </p>
    </div>
  </section>

  <section class="section panel">
    <div class="wrap">
      <SectionHead title="What US bookers ask." />
      <Faq items={USA_FAQ} />
    </div>
  </section>

  <AvailabilityForm
    heading="Check a US date."
    lede="Name the city and the date. You will have availability, a USD quote and the authorisation timeline within one business day."
    market="usa"
    marketName="United States"
    prefillCity="United States"
    currency="USD"
    travel
  />
</Base>

<style>
  .cities {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }
  .cities li {
    background: var(--ink);
    padding: clamp(20px, 2.4vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .cities b {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 600;
    color: var(--bone);
    transition: color var(--t-hover) var(--ease-out);
  }
  .cities li:hover b { color: var(--tan); }
  .note { margin-top: 26px; max-width: 40em; }
  .clink { display: flex; flex-direction: column; gap: 7px; height: 100%; }
  .clink:hover b { color: var(--tan); }
  .clink .tlink { align-self: flex-start; margin-top: 6px; }

  @media (max-width: 820px) { .cities { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .cities { grid-template-columns: 1fr; } }
</style>
