---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Kpi from '../../components/Kpi.astro';
import Faq from '../../components/Faq.astro';
import AvailabilityForm from '../../components/AvailabilityForm.astro';
import { INTERNATIONAL_FAQ } from '../../data/faqs';
import { faqNode, breadcrumbNode } from '../../lib/schema';
import { getAudience, formatFollowers } from '../../lib/audience';
import { currencyRule } from '../../lib/markets';

/**
 * The hub. Live country pages are linked; markets without a page yet are
 * plain text that points to the form, never a link to a thin stub. Cities
 * listed are the ones in her own audience data.
 */
const countries = [
  {
    name: 'United States',
    href: '/international/usa',
    cities: 'Houston, Dallas, Austin, San Antonio, New York, Los Angeles, Chicago',
    live: true,
  },
  { name: 'Brazil', href: '/international/brazil', cities: 'São Paulo', live: true },
  { name: 'France', href: '/international/france', cities: 'Paris, where she competed at the 2024 DMC World Finals', live: true },
  { name: 'United Kingdom', href: null, cities: 'London', live: false },
  { name: 'South Africa', href: null, cities: 'Johannesburg, Cape Town', live: false },
  { name: 'Canada', href: '/canada', cities: 'Toronto, Montreal, Vancouver, Calgary', live: true },
];

const a = await getAudience();
const total = formatFollowers(a);

const reach = [
  ...(total
    ? [{ figure: total, label: 'Followers, the majority outside Canada' }]
    : [{ figure: 'Worldwide', label: 'An audience concentrated outside Canada' }]),
  ...a.highlights.map((h) => ({ figure: h.figure, label: h.label })),
  { figure: String(a.countries.length), label: 'Countries driving most of her reach' },
  { figure: 'YYZ', label: 'Toronto Pearson, direct to most major markets' },
];
---

<Base
  title="International DJ Bookings | DEEJAY T-JR., 3x DMC Canadian Champion"
  description="Book DEEJAY T-JR. internationally. Three-time DMC Canadian Champion travelling from Toronto to the United States, Brazil, France, the United Kingdom and South Africa. Travel logistics, work authorisation and currency handled in-house."
  path="/international"
  schema={[
    faqNode(INTERNATIONAL_FAQ),
    breadcrumbNode([
      { name: 'Home', path: '/' },
      { name: 'International', path: '/international' },
    ]),
  ]}
>
  <Hero
    compact
    headline="Her crowd is already in <em>your</em> city."
    lede="The majority of her audience is outside Canada. If you are promoting a date in the United States, Brazil, France, the United Kingdom or South Africa, you are not introducing her — you are booking someone people there already follow."
    photo="stage-wide"
    note="Travelling from Toronto Pearson."
  />

  <section class="section tight">
    <div class="wrap">
      <SectionHead
        title="Reach, in numbers."
        lede={`From her own analytics${a.asOfLabel ? `, captured ${a.asOfLabel}` : ''}. The full breakdown by country is in the media kit.`}
      />
      <Kpi items={reach} />
    </div>
  </section>

  <section class="section" id="countries">
    <div class="wrap">
      <SectionHead
        title="Where she plays."
        lede="Country pages carry local booking detail, past dates and a contact path for promoters."
      />
      <ul class="countries" data-reveal-group>
        {
          countries.map((c) => {
            const Tag = c.href ? 'a' : 'div';
            return (
              <li>
                <Tag class="country spot" href={c.href ?? undefined}>
                  <h3>{c.name}</h3>
                  <p class="small muted">{c.cities}</p>
                  {c.live ? (
                    <span class="tlink">
                      Open <span class="arw" aria-hidden="true">→</span>
                    </span>
                  ) : (
                    <span class="small pending">
                      Name your city in the form below and we will tell you what she draws there.
                    </span>
                  )}
                </Tag>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="section panel">
    <div class="wrap">
      <SectionHead
        title="How a date outside Canada actually works."
        lede="None of this is unusual for her. It just needs lead time."
      />
      <div class="prose logistics">
        <p>
          She travels from Toronto Pearson, which flies direct to most of North America, western
          Europe and a growing list of Latin American cities. For a typical international date she
          arrives the day before and departs the day after, which means you are budgeting two nights
          of accommodation rather than one.
        </p>
        <p>
          We handle work authorisation for the territory. Lead times vary — six to
          eight weeks is a safe planning assumption, and several markets are considerably faster.
          Tell us the country early and we will tell you the real timeline.
        </p>
        <p>
          Quotes are itemised: performance fee, flights, accommodation and ground transport, so you
          see the landed cost rather than a fee plus surprises. {currencyRule('en')}
        </p>
        <p>
          She plays her own battle setup, or the venue's CDJs where turntables are not practical,
          and needs the venue to supply sound and monitoring. The technical rider on the
          <a href="/press">press page</a> lists both setups.
        </p>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <SectionHead title="What bookers outside Canada ask." />
      <Faq items={INTERNATIONAL_FAQ} />
    </div>
  </section>

  <AvailabilityForm
    heading="Book an international date."
    lede="Include the country and your target date. We will come back with availability, the landed cost and the authorisation timeline."
    currency="USD"
    travel
  />
</Base>

<style>
  .countries { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); }
  .country {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: clamp(24px, 2.8vw, 34px);
    background: var(--ink);
    transition: background var(--t-hover) var(--ease-out);
  }
  a.country:hover { background: var(--panel-hover); }
  .country h3 { font-size: 22px; }
  .country p { flex-grow: 1; }
  .pending { color: color-mix(in srgb, var(--tan) 35%, transparent); font-style: italic; }
  a.country:hover .tlink { border-color: var(--tan); color: var(--tan-lift); }
  a.country:hover .arw { transform: translateX(3px); }

  .logistics { max-width: 42em; }

  @media (max-width: 820px) { .countries { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .countries { grid-template-columns: 1fr; } }
</style>
