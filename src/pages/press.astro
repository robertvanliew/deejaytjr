---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Photo from '../components/Photo.astro';
import StagePlot from '../components/StagePlot.astro';
import { creditFor } from '../data/photos';
import { getCollection } from 'astro:content';
import { AWARDS, ROLES, SITE, ALL_PROFILES, AUTHORITY_RECORDS } from '../data/site';
import { breadcrumbNode } from '../lib/schema';

const pressItems = (await getCollection('press')).sort((a, b) => a.data.order - b.data.order);

/**
 * Three bio lengths, section 6. Written from the credentials in the brief.
 * Reconciled against The Source and The Hype Magazine features (Sept 2026).
 */
const bios = [
  {
    length: '50 words',
    id: 'bio-50',
    text: `DEEJAY T-JR. is a three-time DMC Canadian DJ Champion (2022, 2023, 2024) and the only woman in DMC history to win three consecutive national titles. She finished top nine at the 2023 Technics DMC World Finals. Based in Toronto, she performs for corporate, private, club and festival audiences worldwide.`,
  },
  {
    length: '150 words',
    id: 'bio-150',
    text: `DEEJAY T-JR. is Canada’s most decorated turntablist. She won the DMC Canadian DJ Championship in 2022, 2023 and 2024, making her the only woman in the championship’s history to take three consecutive national titles, and carried that title to London in 2023, where she finished top nine at the Technics DMC World Finals.

She is the only woman to have competed at all four majors: DMC World, IDA World, the Goldie Awards and Red Bull 3Style, where she placed third in the 2018 Canadian final.

Based in Toronto and travelling worldwide, she performs for corporate clients including MLSE, the Government of Ontario and the Fairmont Royal York, for private events, and for clubs and festivals across North America, South America, Europe and Africa. She has showcased at NAMM and for Pioneer DJ, and runs the GIE DJ Academy.`,
  },
  {
    length: '400 words',
    id: 'bio-400',
    text: `DEEJAY T-JR. is a Toronto-based turntablist and the most decorated Canadian DJ of her generation. Between 2022 and 2024 she won the DMC Canadian DJ Championship three years running — a feat no woman in the championship’s history had achieved — and in 2023 she represented Canada at the Technics DMC World Finals in London, finishing in the top nine against the strongest field in competitive turntablism.

Her competitive record spans all four of the sport’s majors. Alongside her DMC titles she reached the technical category finals of the IDA World DJ Championships in 2023, competed at the Goldie Awards in 2019, and placed third at Red Bull 3Style Canada in 2018. She is the only woman to have competed at all four.

Competition is the credential; the work is the room. She performs for corporate clients including MLSE, the Government of Ontario and the Fairmont Royal York, where a booking means holding a ballroom of several hundred people through arrival, dinner and speeches before lifting it on cue. She plays private events where the brief is discretion and a night guests remember. And she headlines clubs and festivals, where her audience — concentrated in the United States, Brazil, France, the United Kingdom and South Africa — turns up for the routines that won the titles.

Her short-form performance videos have built an international following weighted heavily toward the demographic that buys DJ equipment and books talent. That reach has made her a natural partner for gear and lifestyle brands: she has showcased at NAMM, and AlphaTheta and Pioneer DJ have published a full performance of hers on their own channel.

She also teaches. Through the GIE DJ Academy she trains the next set of DJs coming out of Toronto, with particular attention to the ones who, like her, do not see themselves in the booth yet.

DEEJAY T-JR. is available worldwide for corporate events, private events, clubs and festivals, and brand partnerships. Bookings are handled by her team at mgmt@deejaytjr.com.`,
  },
];

/**
 * Client-supplied photography. Credits come from the registry in data/photos.ts
 * so the gallery, the lightbox and anything added later all say the same name.
 * Download links point at the processed files;
 * the originals (up to 8192px) are with her team — noted on the page so
 * a magazine knows a print-resolution file exists.
 */
const pressPhotos = [
  { key: 'hero-decks', label: 'At the decks, DMC eliminations' },
  { key: 'dmc-2024-booth', label: '2024 DMC Canada final' },
  { key: 'portrait-decks', label: 'Portrait, vertical' },
  { key: 'stage-crowd', label: 'Stage and crowd' },
  { key: 'portrait-close', label: 'Portrait, close' },
  { key: 'bastids-bbq', label: "Bastid's BBQ, Toronto" },
  { key: 'raptors905-purple', label: "Raptors 905 Women's Celebration Game" },
  { key: 'raptors905-jumbotron', label: 'Raptors 905, guest DJ on the scoreboard' },
  { key: 'raptors905-booth', label: 'Raptors 905 DJ booth, Paramount Fine Foods Centre' },
] as const;
---

<Base
  title="Press Kit and EPK | DEEJAY T-JR."
  description="Press kit for DEEJAY T-JR., three-time DMC Canadian Champion: hi-res photos, logo pack, bios at three lengths, stage plot, technical rider and the one-sheet for agencies. No form, no gate."
  path="/press"
  schema={[
    breadcrumbNode([
      { name: 'Home', path: '/' },
      { name: 'Press', path: '/press' },
    ]),
  ]}
>
  <section class="section tight pagehead">
    <div class="wrap">
      <h1>Press kit.</h1>
      <p class="lede">
        Everything a planner, promoter, agency or journalist needs, with nothing to fill in first.
        Take what you need. If something is missing, email
        <a class="inline" data-contact href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
      <nav class="jump small" aria-label="Press kit sections">
        <a href="#photos">Photos</a>
        <a href="#logos">Logos</a>
        <a href="#bios">Bios</a>
        <a href="#awards">Awards</a>
        <a href="#tech">Stage plot and rider</a>
        <a href="#featured">Featured in</a>
      </nav>
    </div>
  </section>

  <section class="section tight" id="photos">
    <div class="wrap">
      <SectionHead
        title="Photography."
        lede="Hi-res JPG, 3000px on the long edge. Credit the photographer as listed. Editorial and promotional use in connection with a booking or a story is granted; no other use."
      />
      <div class="photos" data-reveal-group>
        {
          pressPhotos.map((p) => (
            <figure>
              <Photo
                name={p.key}
                widths={[400, 640, 900]}
                sizes="(max-width: 820px) 45vw, 30vw"
                class="pressimg"
              />
              <figcaption class="small muted">
                {p.label}
                {creditFor(p.key) ? (
                  <span class="credit">Photograph: {creditFor(p.key)}</span>
                ) : (
                  <span class="credit">Photographer to be confirmed</span>
                )}
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="small muted phnote">
        Print-resolution originals (up to 8192px) are available from us on request.
        Credit the photographer where one is named.
      </p>
    </div>
  </section>

  <section class="section tight panel" id="logos">
    <div class="wrap">
      <SectionHead
        title="Logo pack."
        lede="Signature mark and circle mark, as SVG plus PNG on black and PNG on white. Do not recolour, rotate, or set the mark on a busy image."
      />
      <div class="logopack">
        <figure class="lp lp-dark">
          <span class="lp-sig" aria-hidden="true"></span>
          <figcaption class="small muted">Signature, sand on ink</figcaption>
        </figure>
        <figure class="lp lp-light">
          <span class="lp-sig" aria-hidden="true"></span>
          <figcaption class="small muted">Signature, ink on bone</figcaption>
        </figure>
        <figure class="lp lp-dark">
          <img src="/logo/seal.png" alt="DEEJAY T-JR. circle seal" width="150" height="150" />
          <figcaption class="small muted">Circle seal, full colour</figcaption>
        </figure>
      </div>
      <p class="small muted lpnote">
        Brand colours: teal <code>#4c6971</code> and sand <code>#d5c9b1</code>. Vector source
        (<code>.ai</code>, <code>.eps</code>) is held by us — ask for it if you need the
        mark above 500px. Do not recolour, rotate or set the mark on a busy image.
      </p>
    </div>
  </section>

  <section class="section" id="bios">
    <div class="wrap">
      <SectionHead
        title="Bios."
        lede="Three lengths. Copy the one that fits your word count. Please keep the name formatted as DEEJAY T-JR., with the period."
      />
      <div class="bios" data-reveal-group>
        {
          bios.map((b) => (
            <article class="bio">
              <header>
                <h3>{b.length}</h3>
                <button class="btn ghost small copy" type="button" data-copy={b.id} aria-live="polite">
                  Copy
                </button>
              </header>
              <div class="prose biotext" id={b.id}>
                {b.text.split('\n\n').map((para) => (
                  <p>{para}</p>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section tight panel" id="awards">
    <div class="wrap">
      <SectionHead title="Awards and results." />
      <ol class="awards">
        {
          AWARDS.map((a) => (
            <li>
              <span class="atitle">{a.title}</span>
              {a.source && (
                <a class="asource" href={a.source} rel="noopener" target="_blank">
                  {a.sourceLabel ?? 'Source'}
                </a>
              )}
            </li>
          ))
        }
      </ol>
      {
        ROLES.length > 0 && (
          <div class="roles">
            <h3 class="rolehead">Positions held</h3>
            <ul>
              {ROLES.map((r) => (
                <li>
                  <b>{r.title}</b>
                  <span class="small muted">{r.detail}</span>
                  {r.source && (
                    <a class="asource" href={r.source} rel="noopener" target="_blank">
                      {r.sourceLabel ?? 'Source'}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class="section" id="tech">
    <div class="wrap">
      <SectionHead
        title="Stage plot and technical rider."
        lede="What she needs from your venue. Most rooms already have it."
      />
      <StagePlot />
    </div>
  </section>

  <section class="section tight" id="featured">
    <div class="wrap">
      <SectionHead title="Featured in." />
      <ul class="featured">
        {
          pressItems.map((p) => (
            <li>
              <span class="outlet">{p.data.outlet}</span>
              {p.data.url ? (
                <a class="tlink" href={p.data.url} rel="noopener" target="_blank">
                  {p.data.title} <span class="arw" aria-hidden="true">→</span>
                </a>
              ) : (
                <span>{p.data.title}</span>
              )}
              {p.data.date && <span class="small muted">{p.data.date}</span>}
            </li>
          ))
        }
      </ul>

      <div class="onesheet">
        <div>
          <h3>One-sheet for agencies</h3>
          <p class="small prose">
            A single page: positioning, credentials, audience and contact. Net rates on request.
          </p>
        </div>
        <div class="slot" style="min-height:120px;max-width:420px">
          <span>
            <b>One-sheet PDF pending</b>
            Generated from this page once photography and confirmed numbers land. The old
            Squarespace PDF at /s/deejay-t-jr-EPK-122.pdf redirects here.
          </span>
        </div>
      </div>

      <div class="socials">
        <h3>Authority records</h3>
        <p class="small prose isni">
          Use these to confirm you have the right person, and cite the name as
          DEEJAY T-JR., with the period.
        </p>
        <ul class="authority">
          {
            AUTHORITY_RECORDS.map((r) => (
              <li>
                <span class="small muted">{r.label}</span>
                <a href={r.url} rel="noopener" target="_blank">
                  {r.value}
                </a>
              </li>
            ))
          }
        </ul>

        <h3>Profiles</h3>
        <ul>
          {
            ALL_PROFILES.map((s) => (
              <li>
                <a href={s.url} rel="me noopener" target="_blank">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .pagehead h1 { margin-bottom: 20px; }
  .inline { color: var(--tan); text-decoration: underline; text-underline-offset: 3px; }

  .jump { display: flex; flex-wrap: wrap; gap: 10px 26px; margin-top: 30px; }
  .jump a { color: var(--muted); border-bottom: 1px solid var(--hairline); padding-bottom: 3px; transition: color var(--t-hover) var(--ease-out), border-color var(--t-hover) var(--ease-out); }
  .jump a:hover { color: var(--tan); border-color: color-mix(in srgb, var(--tan) 35%, transparent); }

  .photos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.5vw, 32px);
  }
  .photos :global(.pressimg) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--hairline);
  }
  .photos figure:nth-child(3) :global(.pressimg),
  .photos figure:nth-child(5) :global(.pressimg) { aspect-ratio: 4 / 5; }
  .phnote { margin-top: 22px; max-width: 44em; }
  figcaption { margin-top: 10px; }
  .credit { display: block; color: var(--tan); opacity: .8; font-style: italic; margin-top: 3px; }

  .logopack {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
  }
  .lp {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 40px 24px 22px;
    min-height: 230px;
  }
  .lp-dark { background: var(--ink); }
  .lp-light { background: #f0ebe0; }
  .lp-light figcaption { color: #5b6b6e; }
  .lp-sig {
    width: 150px;
    height: 77px;
    -webkit-mask: url('/logo/signature-mask.png') no-repeat center / contain;
    mask: url('/logo/signature-mask.png') no-repeat center / contain;
  }
  .lp-dark .lp-sig { background: var(--tan); }
  .lp-light .lp-sig { background: #2b3d42; }
  .lp img { width: 150px; height: 150px; }
  .lpnote { margin-top: 20px; max-width: 44em; }
  .lpnote code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px;
    color: var(--tan);
  }
  @media (max-width: 640px) { .logopack { grid-template-columns: 1fr; } }

  .bios { display: flex; flex-direction: column; gap: 1px; }
  .bio { border-top: 1px solid var(--hairline); padding: 26px 0; }
  .bio:last-child { border-bottom: 1px solid var(--hairline); }
  .bio header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }
  .bio h3 { font-size: 21px; }
  .biotext { max-width: 42em; }
  .biotext :global(p + p) { margin-top: 1em; }

  .awards { list-style: none; max-width: 46em; }
  .awards li {
    padding: 13px 0;
    border-bottom: 1px solid var(--hairline);
    font-family: var(--serif);
    font-size: 19px;
    color: var(--body);
  }
  .awards li:first-child { border-top: 1px solid var(--hairline); color: var(--bone); }
  .awards li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 24px;
  }
  .atitle { flex: 1 1 auto; }
  /* A result a promoter can click and confirm is worth more than one they have
     to take on trust. */
  .asource {
    font-family: var(--sans);
    font-size: 12.5px;
    color: var(--muted);
    white-space: nowrap;
    border-bottom: 1px solid transparent;
    transition: color var(--t-hover) var(--ease-out), border-color var(--t-hover) var(--ease-out);
  }
  .asource:hover { color: var(--tan); border-bottom-color: var(--tan); }
  .roles { margin-top: 40px; }
  .rolehead {
    font-family: var(--sans);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 14px;
  }
  .roles ul { list-style: none; max-width: 48em; }
  .roles li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .roles li:first-child { border-top: 1px solid var(--hairline); }
  .roles b { font-family: var(--serif); font-size: 21px; color: var(--tan); }
  .roles .asource { width: fit-content; margin-top: 2px; }



  .featured { list-style: none; max-width: 52em; }
  .featured li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .featured li:first-child { border-top: 1px solid var(--hairline); }
  .outlet { color: var(--muted); font-size: 13.5px; min-width: 14em; }

  .onesheet {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 3vw, 44px);
    align-items: center;
    margin-top: 48px;
    padding-top: 36px;
    border-top: 1px solid var(--hairline);
  }
  .onesheet h3 { font-size: 21px; margin-bottom: 10px; }

  .socials { margin-top: 44px; padding-top: 30px; border-top: 1px solid var(--hairline); }
  .socials h3 { font-family: var(--sans); font-size: 13.5px; font-weight: 600; margin-bottom: 14px; }
  .socials h3 + .isni { margin-bottom: 26px; max-width: 44em; }
  .authority { list-style: none; margin-bottom: 30px; max-width: 44em; }
  .authority li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .authority li:first-child { border-top: 1px solid var(--hairline); }
  .authority li > span { min-width: 9em; }
  .authority a {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    color: var(--tan);
    word-break: break-all;
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-hover) var(--ease-out);
  }
  .authority a:hover { border-bottom-color: var(--tan); }
  .socials ul { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 26px; }
  .socials a { color: var(--body); font-size: 14.5px; transition: color var(--t-hover) var(--ease-out); }
  .socials a:hover { color: var(--tan); }

  @media (max-width: 820px) {
    .photos { grid-template-columns: repeat(2, 1fr); }
    .onesheet { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .photos { grid-template-columns: 1fr; }
  }
</style>

<script>
  /** Copy button on each bio. Section 6. */
  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const target = document.getElementById(btn.dataset.copy!);
      if (!target) return;
      const text = [...target.querySelectorAll('p')].map((p) => p.textContent?.trim()).join('\n\n');

      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
      } catch {
        // Clipboard API is blocked in some contexts. Select the text so the
        // visitor can copy it themselves rather than being told nothing.
        const range = document.createRange();
        range.selectNodeContents(target);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        btn.textContent = 'Selected — press Ctrl/Cmd+C';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 2500);
    });
  });
</script>
