---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { PHOTOS, creditFor, type PhotoKey } from '../data/photos';

/**
 * "On the record" — one full-width block that rotates through her coverage,
 * ending on the press kit.
 *
 * Three equal cards in a grid read as a list. One block at a time reads as a
 * headline, which is what a feature in The Source is. It also gives every
 * article room for her photograph beside it instead of a wall of type.
 *
 * Clicking a feature opens it in a reader popup rather than leaving the site.
 * The popup is a summary card plus a link out, NOT the article inside a
 * frame: The Hype Magazine sends X-Frame-Options: SAMEORIGIN, so an iframe
 * would show a dead grey box for that outlet, and reproducing the article text
 * here would be republishing someone else's journalism. The summary is ours;
 * the full text stays where it was published, one click away.
 *
 * The photo on each slide is hers, from the registry, credited — never the
 * outlet's lead image, which we have no rights to.
 *
 * Rotation pauses whenever someone could be reading: on hover, on keyboard
 * focus, while the popup is open, while the block is off-screen, and while
 * the tab is hidden. With reduced motion it does not auto-rotate at all.
 */
export interface Props {
  /** How many articles before the press-kit slide. Two keeps every slide on
      its own photograph; beyond that, entries without a `photo` would share
      the fallback and the rotation would visibly repeat itself. */
  limit?: number;
}
const { limit = 2 } = Astro.props;

const FALLBACK: PhotoKey = 'hero-decks';
const isKey = (k: string | undefined): k is PhotoKey => !!k && k in PHOTOS;

const articles = (await getCollection('press'))
  .filter((p) => p.data.url)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, limit);

const fmt = (iso?: string) =>
  iso
    ? new Date(`${iso}T12:00:00`).toLocaleDateString('en-CA', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    : undefined;

const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');

const slides = await Promise.all(
  articles.map(async (a) => {
    const d = a.data;
    const key: PhotoKey = isKey(d.photo) ? d.photo : FALLBACK;
    const big = await getImage({ src: PHOTOS[key].src, width: 1200, format: 'webp' });
    return {
      kind: 'article' as const,
      key,
      title: d.title,
      outlet: d.outlet,
      byline: d.byline,
      when: fmt(d.published) ?? d.date,
      excerpt: d.excerpt,
      url: d.url!,
      host: host(d.url!),
      big: big.src,
      credit: creditFor(key),
    };
  })
);

const kitKey: PhotoKey = 'dmc-2024-booth';
const total = slides.length + 1;
---

<div class="pc" data-pc aria-roledescription="carousel" aria-label="Press coverage">
  <div class="viewport">
    {
      slides.map((s, i) => (
        <article
          class:list={['slide', i === 0 && 'on']}
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${total}`}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <div class="media">
            <Image
              src={PHOTOS[s.key].src}
              alt={PHOTOS[s.key].alt}
              widths={[480, 760, 1100]}
              sizes="(max-width: 820px) 100vw, 46vw"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
            {s.credit && <span class="pcred">Photograph: {s.credit}</span>}
          </div>
          <div class="copy">
            <span class="small muted outlet">
              Featured in <b>{s.outlet}</b>
              {s.when && <> · {s.when}</>}
            </span>
            <h3>{s.title}</h3>
            <p class="prose">{s.excerpt}</p>
            <button
              class="tlink open"
              type="button"
              tabindex={i === 0 ? undefined : -1}
              data-article
              data-url={s.url}
              data-title={s.title}
              data-outlet={s.outlet}
              data-host={s.host}
              data-byline={s.byline}
              data-when={s.when}
              data-excerpt={s.excerpt}
              data-img={s.big}
              data-credit={s.credit}
            >
              Read the feature <span class="arw" aria-hidden="true">→</span>
            </button>
          </div>
        </article>
      ))
    }

    <article
      class="slide"
      aria-roledescription="slide"
      aria-label={`${total} of ${total}`}
      aria-hidden="true"
    >
      <div class="media">
        <Image
          src={PHOTOS[kitKey].src}
          alt={PHOTOS[kitKey].alt}
          widths={[480, 760, 1100]}
          sizes="(max-width: 820px) 100vw, 46vw"
          loading="lazy"
        />
        {creditFor(kitKey) && <span class="pcred">Photograph: {creditFor(kitKey)}</span>}
      </div>
      <div class="copy">
        <span class="small muted outlet">Press kit</span>
        <h3>Photos, bio, stage plot and tech rider for planners, agencies and media</h3>
        <p class="prose">
          Hi-res images with credits, logo pack, three bio lengths and the technical rider. No
          form, no gate.
        </p>
        <a class="tlink open" href="/press" tabindex="-1">
          Open the press kit <span class="arw" aria-hidden="true">→</span>
        </a>
      </div>
    </article>
  </div>

  <div class="controls">
    <div class="dots" role="tablist" aria-label="Choose a slide">
      {
        Array.from({ length: total }, (_, i) => (
          <button
            class:list={['dot', i === 0 && 'on']}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={`Slide ${i + 1} of ${total}`}
            data-go={i}
          >
            <span class="bar"><span class="fill" /></span>
          </button>
        ))
      }
    </div>
    <div class="arrows">
      <span class="small muted count" aria-live="off"><b data-count>1</b> / {total}</span>
      <button class="arrow" type="button" data-prev aria-label="Previous">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </button>
      <button class="arrow" type="button" data-next aria-label="Next">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </button>
    </div>
  </div>
</div>

<dialog class="adlg" aria-labelledby="adlg-title">
  <div class="sheet">
    <button class="x" type="button" data-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
    </button>
    <figure class="hero">
      <img data-a-img alt="" />
      <figcaption class="pcred" data-a-credit></figcaption>
    </figure>
    <div class="body">
      <span class="small muted outlet" data-a-meta></span>
      <h2 id="adlg-title" data-a-title></h2>
      <p class="small muted byline" data-a-byline></p>
      <p class="prose" data-a-excerpt></p>
      <a class="btn" data-a-read rel="noopener" target="_blank">
        Read the full article <span aria-hidden="true">↗</span>
      </a>
      <p class="small muted src">Opens on <span data-a-host></span>. The full text is theirs; this is our summary.</p>

      <div class="share">
        <span class="small muted sharelabel">Share this feature</span>
        <div class="sharerow">
          <button class="sbtn native" type="button" data-share-native hidden>
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 13v6h14v-6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            Share
          </button>
          <button class="sbtn story" type="button" data-share-story>
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="3" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="12" cy="11" r="3" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            Share to story
          </button>
          <a class="sbtn" data-share="x" rel="noopener" target="_blank" aria-label="Share on X">X</a>
          <a class="sbtn" data-share="facebook" rel="noopener" target="_blank" aria-label="Share on Facebook">Facebook</a>
          <a class="sbtn" data-share="linkedin" rel="noopener" target="_blank" aria-label="Share on LinkedIn">LinkedIn</a>
          <a class="sbtn" data-share="whatsapp" rel="noopener" target="_blank" aria-label="Share on WhatsApp">WhatsApp</a>
          <a class="sbtn" data-share="email" aria-label="Share by email">Email</a>
          <button class="sbtn" type="button" data-share-copy>Copy link</button>
        </div>
        <p class="small muted sharenote" data-share-note aria-live="polite"></p>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* ---------- carousel ---------- */
  .pc {
    border: 1px solid var(--hairline);
    background: var(--panel);
  }
  /* Every slide occupies the same grid cell, so the block is always as tall
     as its tallest slide and never jumps as they change. */
  .viewport { display: grid; touch-action: pan-y; }
  .slide {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    opacity: 0;
    visibility: hidden;
    transform: translateX(14px);
    transition: opacity 520ms var(--ease-out), transform 620ms var(--ease-out), visibility 0s linear 620ms;
  }
  .slide.on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 520ms var(--ease-out), transform 620ms var(--ease-out), visibility 0s;
  }
  .slide.out-left { transform: translateX(-14px); }

  .media { position: relative; overflow: hidden; min-height: 320px; background: var(--ink); }
  .media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pcred {
    position: absolute;
    left: 12px;
    bottom: 10px;
    font-size: 11.5px;
    color: var(--bone);
    background: color-mix(in srgb, var(--ink) 62%, transparent);
    padding: 3px 8px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(28px, 4vw, 56px);
  }
  .outlet b { color: var(--tan); font-weight: 600; }
  .copy h3 {
    font-size: clamp(26px, 2.6vw, 36px);
    line-height: 1.1;
    color: var(--bone);
    text-wrap: balance;
  }
  .copy .prose { max-width: 34em; flex-grow: 1; }
  .open { align-self: flex-start; background: none; border-left: 0; border-right: 0; border-top: 0; cursor: pointer; font: inherit; }
  .open:hover { border-color: var(--tan); color: var(--tan-lift); }
  .open:hover .arw { transform: translateX(3px); }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 14px clamp(18px, 2.4vw, 28px);
    border-top: 1px solid var(--hairline);
  }
  .dots { display: flex; gap: 8px; flex: 1; max-width: 360px; }
  .dot { flex: 1; padding: 10px 0; background: none; border: 0; cursor: pointer; }
  .bar { display: block; height: 2px; background: var(--hairline); overflow: hidden; }
  .fill { display: block; height: 100%; width: 0; background: var(--tan); }
  .dot.on .fill { width: 100%; }
  /* The active bar fills over the rotation interval — a visible clock, so
     the change never arrives as a surprise. */
  .pc[data-playing] .dot.on .fill { width: 0; animation: pcfill var(--pc-ms, 7000ms) linear forwards; }
  .pc[data-paused] .dot.on .fill { animation-play-state: paused; }
  @keyframes pcfill { to { width: 100%; } }

  .arrows { display: flex; align-items: center; gap: 8px; }
  .count { margin-right: 6px; font-variant-numeric: tabular-nums; }
  .count b { color: var(--bone); font-weight: 600; }
  .arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--hairline);
    background: none;
    color: var(--body);
    cursor: pointer;
    transition: border-color var(--t-hover) var(--ease-out), color var(--t-hover) var(--ease-out), transform var(--t-press) var(--ease-out);
  }
  .arrow:hover { border-color: var(--tan); color: var(--bone); }
  .arrow:active { transform: scale(0.95); }

  @media (max-width: 820px) {
    .slide { grid-template-columns: 1fr; }
    .media { min-height: 0; aspect-ratio: 4 / 3; }
    .count { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide, .slide.on { transition: opacity 1ms; transform: none; }
  }

  /* ---------- article dialog ---------- */
  .adlg:not([open]) { display: none; }
  .adlg {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: clamp(10px, 3vw, 36px);
    border: 0;
    background: transparent;
    display: grid;
    place-items: center;
    overflow: auto;
    color: var(--body);
  }
  .adlg::backdrop {
    background: color-mix(in srgb, var(--ink) 88%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .adlg[open]::backdrop { animation: adveil 300ms var(--ease-out); }
    .adlg[open] .sheet { animation: adrise 420ms var(--ease-out); }
  }
  @keyframes adveil { from { opacity: 0; } }
  @keyframes adrise { from { opacity: 0; transform: translateY(14px) scale(0.985); } }

  .sheet {
    position: relative;
    width: min(760px, 100%);
    background: var(--panel);
    border: 1px solid var(--hairline);
  }
  .hero { position: relative; margin: 0; aspect-ratio: 16 / 8; overflow: hidden; background: var(--ink); }
  .hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero .pcred:empty { display: none; }
  .body { padding: clamp(22px, 4vw, 40px); display: flex; flex-direction: column; gap: 14px; }
  .body h2 { font-family: var(--serif); font-size: clamp(26px, 3.4vw, 38px); line-height: 1.1; color: var(--bone); text-wrap: balance; }
  .byline:empty { display: none; }
  .body .btn { align-self: flex-start; margin-top: 6px; }
  .src { margin-top: -4px; }

  .share { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--hairline); }
  .sharelabel { display: block; margin-bottom: 12px; }
  .sharerow { display: flex; flex-wrap: wrap; gap: 8px; }
  .sbtn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    padding: 0 14px;
    font: inherit;
    font-size: 13.5px;
    color: var(--body);
    background: var(--surface);
    border: 1px solid var(--hairline);
    cursor: pointer;
    text-decoration: none;
    transition: border-color var(--t-hover) var(--ease-out), color var(--t-hover) var(--ease-out), transform var(--t-press) var(--ease-out);
  }
  .sbtn:hover { border-color: var(--tan); color: var(--bone); }
  .sbtn:active { transform: scale(0.97); }
  .sbtn.story, .sbtn.native { color: var(--ink); background: var(--tan); border-color: var(--tan); }
  .sbtn.story:hover, .sbtn.native:hover { background: var(--tan-lift); color: var(--ink); }
  .sbtn[hidden] { display: none; }
  .sharenote { margin-top: 10px; min-height: 1.4em; }

  .x {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 60%, transparent);
    color: var(--bone);
    cursor: pointer;
  }
  .x:hover { border-color: var(--tan); }
</style>

<script>
  import { pressCarousel } from '../lib/pressCarousel';
  pressCarousel();
</script>
