---
/**
 * A genuine sequence, so it stays an <ol>: the order is still conveyed to
 * assistive technology and to crawlers even though the visible "Step 1/2/3"
 * labels have been removed. The tan rule above each step carries the rhythm
 * visually.
 */
export interface Props {
  steps?: { title: string; body: string }[];
}

const defaultSteps = [
  {
    title: 'Tell us about the event',
    body: 'Date, city, venue, guest count and what the night needs to do. You will hear back within one business day with availability and a quote.',
  },
  {
    title: 'Lock the date',
    body: 'A short performance agreement and a deposit hold the date. You get the tech rider, input list and a planning call with our team.',
  },
  {
    title: 'T-JR. builds the set for your room',
    body: 'Music direction, run-of-show timing and any showcase moments are mapped with your planner in advance. Then she reads the room live.',
  },
];

const { steps = defaultSteps } = Astro.props;
---

<ol class="steps" data-reveal-group>
  {
    steps.map((s) => (
      <li class="step">
        <h3>{s.title}</h3>
        <p class="prose">{s.body}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(28px, 4vw, 56px);
  }
  .step { border-top: 2px solid var(--tan); padding-top: 22px; }
  /* The accent rule from the prototype becomes a tan rule that draws itself in
     as the step reveals — the sequence reads as a sequence. */
  .step { position: relative; }
  .step::before {
    content: '';
    position: absolute;
    inset-block-start: -2px;
    inset-inline-start: 0;
    width: 100%;
    height: 2px;
    background: var(--tan-lift);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 700ms var(--ease-out) var(--reveal-delay, 0ms);
  }
  .steps :global([data-shown])::before { transform: scaleX(1); }
  .step h3 { margin-bottom: 12px; }
  .step p { max-width: 30em; }

  @media (max-width: 820px) {
    .steps { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
