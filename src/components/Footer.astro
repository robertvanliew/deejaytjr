---
import Brand from './Brand.astro';
import { SITE, SOCIALS, MUSIC_PLATFORMS, SUPPORT_PLATFORMS } from '../data/site';
import { MARKETS, nameOf, type Locale } from '../lib/markets';
import { CHROME } from '../i18n/ui';

export interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const c = CHROME[locale];
const L = (href: string, en: string) => c.links[href] ?? en;

/* International column: built from data/markets.json, live English pages only,
   so a city appears here the moment its page goes live and never before.
   Countries first, each followed by its cities. */
const intl = MARKETS.filter((m) => m.kind === 'country' && m.pages.en?.reviewed).flatMap((c) => [
  { label: nameOf(c, locale), href: c.pages.en!.path, city: false },
  ...MARKETS.filter((m) => m.kind === 'city' && m.parent === c.key && m.pages.en?.reviewed).map((m) => ({
    label: nameOf(m, locale),
    href: m.pages.en!.path,
    city: true,
  })),
]);

const year = new Date().getFullYear();

const columns = [
  {
    title: c.cols.book,
    links: [
      { label: L('/clubs-and-festivals', 'Clubs and festivals'), href: '/clubs-and-festivals' },
      { label: L('/private-events', 'Private events'), href: '/private-events' },
      { label: L('/corporate-events', 'Corporate events'), href: '/corporate-events' },
      { label: L('/corporate-events/holiday-parties', 'Holiday parties'), href: '/corporate-events/holiday-parties', city: true },
      { label: L('/brand-partnerships', 'Brand partnerships'), href: '/brand-partnerships' },
      { label: L('/canada', 'Across Canada'), href: '/canada' },
      { label: L('/contact', 'Check availability'), href: locale === 'en' ? '/contact' : '#availability' },
    ],
  },
  {
    title: c.cols.about,
    links: [
      { label: L('/about', 'The story'), href: '/about' },
      { label: L('/press', 'Press and EPK'), href: '/press' },
      { label: L('/media-kit', 'Media kit'), href: '/media-kit' },
      { label: L('/latest', 'Latest'), href: '/latest' },
      { label: L('/watch', 'Watch'), href: '/watch' },
    ],
  },
  {
    title: c.cols.intl,
    links: [
      { label: c.allMarkets, href: '/international' },
      ...intl,
      { label: L('/destination-events', 'Destination events'), href: '/destination-events' },
    ],
  },
  {
    /* Music, merch and support live down here on purpose. Section 3. */
    title: c.cols.listen,
    links: [
      { label: L('/music', 'Listen'), href: '/music' },
      /* Bandcamp appears twice in this column — catalogue and merch. Bare
         "Bandcamp" next to "Merch on Bandcamp" reads as though the first one
         is the ambiguous leftover, so it is labelled by what it does. */
      ...MUSIC_PLATFORMS.map((m) => ({
        label: m.label === 'Bandcamp' ? c.listenBandcamp : m.label,
        href: m.url,
        external: true,
      })),
      ...SUPPORT_PLATFORMS.map((m) => ({ label: m.label, href: m.url, external: true })),
      { label: c.merch, href: 'https://deejaytjr.bandcamp.com/merch', external: true },
    ],
  },
];
---

<footer class="foot">
  <div class="wrap">
    <div class="grid">
      <div class="col brandcol">
        <Brand size={34} />
        <p class="small muted">
          {c.blurb(SITE.homeCity)}
        </p>
        <a class="tlink" data-contact href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>

      {
        columns.map((col) => (
          <nav class="col" aria-label={col.title}>
            <h2 class="coltitle">{col.title}</h2>
            <ul>
              {col.links.map((l) => (
                <li class:list={['city' in l && l.city && 'sub']}>
                  <a
                    href={l.href}
                    rel={'external' in l && l.external ? 'noopener' : undefined}
                    target={'external' in l && l.external ? '_blank' : undefined}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="social">
      <span class="small muted">{c.follow}</span>
      <ul>
        {
          SOCIALS.map((s) => (
            <li>
              <a href={s.url} rel="me noopener" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="legal">
      <p class="small muted copy">© {year} {SITE.name} {c.rights}</p>
      <div class="legal-right">
        <nav class="small" aria-label="Legal">
          <a href="/privacy">{c.privacy}</a>
          <a href="/terms">{c.terms}</a>
        </nav>
        <p class="small credit">
          {c.designBy}
          <a
            class="designer"
            href="https://robertvanliew.com"
            rel="noopener"
            target="_blank"
            title="robertvanliew.com"
          >Robert Van Liew<span class="go" aria-hidden="true">↗</span></a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--panel);
    border-top: 1px solid var(--hairline);
    padding-block: clamp(56px, 7vw, 88px) 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.3fr repeat(4, 1fr);
    gap: 48px 40px;
  }
  .brandcol { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .brandcol p { max-width: 26em; }

  .coltitle {
    font-family: var(--sans);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--bone);
    letter-spacing: 0;
    line-height: 1.4;
    margin-bottom: 16px;
  }
  .col ul { list-style: none; display: flex; flex-direction: column; gap: 11px; }
  .col a {
    font-size: 14.5px;
    color: var(--muted);
    transition: color var(--t-hover) var(--ease-out);
  }
  .col a:hover { color: var(--tan); }
  /* Cities sit under their country, indented, so the column reads as a map. */
  .col li.sub a { padding-left: 14px; position: relative; font-size: 14px; }
  .col li.sub a::before { content: ''; position: absolute; left: 0; top: 50%; width: 7px; height: 1px; background: var(--hairline); }

  .social {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 24px;
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: 26px;
    border-top: 1px solid var(--hairline);
  }
  .social ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  .social a {
    font-size: 14px;
    color: var(--body);
    transition: color var(--t-hover) var(--ease-out);
  }
  .social a:hover { color: var(--tan); }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 26px;
    padding-top: 22px;
    border-top: 1px solid var(--hairline);
  }
  .legal { align-items: baseline; }
  .legal-right { display: flex; align-items: baseline; gap: 22px; }
  .legal nav { display: flex; gap: 22px; }
  .legal a { color: var(--muted); transition: color var(--t-hover) var(--ease-out); }
  .legal a:hover { color: var(--bone); }

  /* Designer credit. Sits on the same baseline as Privacy and Terms, divided
     from them by a hairline, so it reads as part of the bar rather than an
     afterthought. The name lifts to tan and shows its arrow on hover. */
  .credit { margin: 0; max-width: none; color: var(--muted); padding-left: 22px; border-left: 1px solid var(--hairline); }
  .credit .designer {
    color: var(--body);
    border-bottom: 1px solid transparent;
    transition: color var(--t-hover) var(--ease-out), border-color var(--t-hover) var(--ease-out);
  }
  .credit .designer:hover, .credit .designer:focus-visible { color: var(--tan); border-bottom-color: var(--tan); }
  .credit .go {
    display: inline-block;
    margin-left: 3px;
    opacity: 0;
    transform: translate(-2px, 2px);
    transition: opacity var(--t-hover) var(--ease-out), transform var(--t-hover) var(--ease-out);
  }
  .credit .designer:hover .go, .credit .designer:focus-visible .go { opacity: 1; transform: none; }

  @media (max-width: 1100px) {
    .grid { grid-template-columns: repeat(4, 1fr); }
    .brandcol { grid-column: 1 / -1; }
  }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  /* Mobile: copyright, then the links, then the credit, each on its own line
     and left-aligned, so nothing wraps into a ragged row. */
  @media (max-width: 640px) {
    .legal { flex-direction: column; align-items: flex-start; gap: 14px; }
    .legal-right { flex-direction: column; align-items: flex-start; gap: 12px; }
    .credit { padding-left: 0; border-left: 0; }
    .credit .go { opacity: 1; transform: none; }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
