---
/**
 * Fills the "selected work" slot on /private-events.
 *
 * Private hosts are not named, so there is no list of past events to show and
 * no point pretending otherwise. What a host actually needs to know at this
 * point in the page is: will she keep it private, will she come to where the
 * event is, and has she worked abroad before. All three are answerable with
 * facts, so that is what this says.
 *
 * Every claim is verified: London 2023 and Paris 2024 are her DMC World
 * Finals; Tokyo 2025 she hosted; nothing here names a private client.
 */
const cards = [
  {
    kicker: 'At home',
    title: 'Toronto and across Ontario',
    body: 'Weddings, milestone birthdays, anniversaries and private dinners. Planned with you in advance; nothing filmed or posted without your written say-so.',
    href: '/contact?type=private',
    cta: 'Check a date',
  },
  {
    kicker: 'Abroad',
    title: 'Your celebration, wherever it is',
    body: 'Destination weddings, villa weekends, milestone trips. She flies in, and you get one itemised landed cost covering the fee, flights, hotel and ground transport.',
    href: '/destination-events',
    cta: 'How destination events work',
  },
  {
    kicker: 'Already travelled',
    title: 'London, Paris, Tokyo',
    body: 'World Finals stages in London (2023) and Paris (2024), and host of the 40th DMC World Championships in Tokyo (2025). Long-haul is routine.',
    href: '/latest',
    cta: 'See the latest',
  },
];
---

<section class="section panel" id="private-work">
  <div class="wrap">
    <div class="head">
      <h2>Private work stays <em>private</em>.</h2>
      <p class="lede">
        Hosts are never named here without their written permission. What we can show you is
        where she works, and how a private booking travels.
      </p>
    </div>
    <ul class="cards" data-reveal-group>
      {
        cards.map((c) => (
          <li>
            <a class="card spot" href={c.href}>
              <span class="small muted kicker">{c.kicker}</span>
              <h3>{c.title}</h3>
              <p class="small prose">{c.body}</p>
              <span class="tlink">{c.cta} <span class="arw" aria-hidden="true">→</span></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px 64px; align-items: end; margin-bottom: clamp(32px, 4vw, 52px); }
  .head h2 { font-size: var(--h2); line-height: 1.04; }
  .cards { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); }
  .card { display: flex; flex-direction: column; gap: 12px; height: 100%; padding: clamp(24px, 2.8vw, 36px); background: var(--panel); transition: background var(--t-hover) var(--ease-out); }
  .card:hover { background: var(--panel-hover); }
  .kicker { letter-spacing: .05em; text-transform: uppercase; font-size: 12px; }
  .card h3 { font-size: 24px; line-height: 1.15; }
  .card p { flex-grow: 1; }
  .tlink { align-self: flex-start; }
  .card:hover .tlink { color: var(--tan-lift); border-color: var(--tan); }
  .card:hover .arw { transform: translateX(3px); }
  @media (max-width: 860px) {
    .head { grid-template-columns: 1fr; }
    .cards { grid-template-columns: 1fr; }
  }
</style>
