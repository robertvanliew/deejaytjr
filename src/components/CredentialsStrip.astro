---
import { getCredentials } from '../lib/audience';

export interface Props {
  /** Override for service pages that lead with buyer-specific proof. */
  items?: { stat: string; detail: string }[];
  label?: string;
}
const { items, label = 'Credentials' } = Astro.props;
/* No override means the site-wide set, whose follower figure comes from the
   audience snapshots rather than from a number typed into this file. */
const cells = items ?? (await getCredentials());
const cols = cells.length === 3 ? 3 : 4;
---

<section class="creds" aria-label={label}>
  <div class="wrap">
    <div class={`hgrid bare cols-${cols}`} data-reveal-group>
      {
        cells.map((c) => (
          <div class="cred">
            <b data-count={/\d/.test(c.stat) ? "" : undefined}>{c.stat}</b>
            <span class="small muted">{c.detail}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .creds {
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    background: var(--ink);
  }

  .cred { padding: 28px; }
  .cred b {
    display: block;
    font-family: var(--serif);
    font-size: 30px;
    font-weight: 600;
    line-height: 1.1;
    color: var(--bone);
    margin-bottom: 6px;
    text-wrap: balance;
  }
  .cred span { display: block; }

  /* Flush the outer edges to the content column so the strip reads as part of
     the page grid rather than as a floating box. The 1px separators still land
     in the grid gaps, so nothing goes ragged. */
  .cred:first-child { padding-inline-start: 0; }
  .cred:last-child { padding-inline-end: 0; }

  @media (max-width: 820px) {
    .cred { padding: 22px 20px; }
    .cred b { font-size: 24px; }
    /* Two columns: every odd cell starts the row, every even cell ends it. */
    .cred:nth-child(odd) { padding-inline-start: 0; }
    .cred:nth-child(even) { padding-inline-end: 0; }
  }
  @media (max-width: 560px) {
    .cred { padding-inline: 0 !important; }
  }
</style>
