---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import SectionHead from './SectionHead.astro';
import Faq from './Faq.astro';
import VideoTile from './VideoTile.astro';
import TravelFacts from './TravelFacts.astro';
import AvailabilityForm from './AvailabilityForm.astro';
import { t, LANE_TEXT } from '../i18n/ui';
import {
  market as getMarket,
  nameOf,
  alternates,
  liveHref,
  citiesOf,
  LANG_TAG,
  type Locale,
} from '../lib/markets';
import { serviceNode, faqNode, breadcrumbNode } from '../lib/schema';
import { SITE } from '../data/site';
import { PHOTOS, type PhotoKey } from '../data/photos';

/**
 * The Country and City templates (spec, Oct 2026), as one component with two
 * layouts, because they share their head, proof line, logistics, FAQ, schema
 * and form. Everything a page says comes from its entry in data/markets.json.
 *
 * Country, top to bottom: H1 naming the market, audience proof, city cards
 * (linked only where the city page is live), how a date works, the routing
 * offer, FAQ, form with the country prefilled.
 *
 * City: H1 with the service in the searcher's words, the required local proof
 * line, a video, booking lanes for that city, nearby routing, FAQ, form with
 * the city prefilled.
 *
 * A page with no proof line does not render: the spec forbids a city page
 * without one real local fact, and this enforces it at build time.
 */
export interface Props {
  marketKey: string;
  locale: Locale;
}
const { marketKey, locale } = Astro.props;

const m = getMarket(marketKey);
const page = m.pages[locale];
if (!page?.h1 || !page.proof) {
  throw new Error(`Market page ${marketKey}/${locale} is missing its h1 or local proof line.`);
}
const s = t(locale);
const name = nameOf(m, locale);
const parent = m.parent ? getMarket(m.parent) : null;
const countryName = parent ? nameOf(parent, locale) : name;
const isCity = m.kind === 'city';
const draft = !page.reviewed;
const alts = alternates(m, locale);
const currency = m.currency ?? parent?.currency ?? 'USD';

const photo: PhotoKey = (m.photo && m.photo in PHOTOS ? m.photo : 'stage-wide') as PhotoKey;
const video = isCity && m.video ? await getEntry('videos', m.video) : undefined;

const cityCards = !isCity
  ? (m.cities ?? []).map((k) => {
      const c = getMarket(k);
      return { name: nameOf(c, locale), href: liveHref(k, locale) };
    })
  : [];
const nearby = (m.nearby ?? []).map((k) => {
  const c = getMarket(k);
  return { name: nameOf(c, locale), href: liveHref(k, locale) };
});

const homeLabel = { en: 'Home', 'pt-br': 'Início', fr: 'Accueil' }[locale];
const intlLabel = { en: 'International', 'pt-br': 'Internacional', fr: 'International' }[locale];
const crumbs = [
  { name: homeLabel, path: '/' },
  { name: intlLabel, path: '/international' },
  ...(parent && parent.pages[locale] ? [{ name: countryName, path: parent.pages[locale]!.path }] : []),
  ...(isCity && parent && !parent.pages[locale] && parent.pages.en ? [{ name: nameOf(parent, 'en'), path: parent.pages.en.path }] : []),
  { name, path: page.path },
];

const schema = [
  serviceNode({
    name: page.title ?? `${SITE.name} in ${name}`,
    description: page.description ?? page.lede ?? '',
    url: `${SITE.url}${page.path}`,
    serviceType: ['DJ performance', 'Turntablism showcase', 'Event hosting'],
    area: isCity ? { type: 'City', name, country: countryName } : { type: 'Country', name },
    availableLanguage: [LANG_TAG[locale]],
  }),
  ...(page.faq?.length ? [faqNode(page.faq)] : []),
  breadcrumbNode(crumbs),
];
---

<Base
  title={page.title ?? name}
  description={page.description ?? ''}
  path={page.path}
  schema={schema}
  locale={locale}
  alternates={alts}
  draft={draft}
>
  <Hero
    compact
    headline={page.h1}
    lede={page.lede ?? ''}
    photo={photo}
    note={page.proofSource}
    primary={{ label: s.checkAvail, href: '#availability' }}
  />

  <section class="section tight">
    <div class="wrap">
      <div class="proof">
        <span class="small muted kicker">{s.audience}</span>
        <p class="proofline">{page.proof}</p>
        {page.proofSource && <span class="small muted">{s.source}: {page.proofSource}</span>}
      </div>
    </div>
  </section>

  {
    !isCity && cityCards.length > 0 && (
      <section class="section">
        <div class="wrap">
          <SectionHead title={s.cities} />
          <ul class="cards" data-reveal-group>
            {cityCards.map((c) =>
              c.href ? (
                <li><a class="card spot" href={c.href}><b>{c.name}</b><span class="tlink">→</span></a></li>
              ) : (
                <li><div class="card"><b>{c.name}</b></div></li>
              )
            )}
          </ul>
          <p class="small muted note">{s.cityNameYours}</p>
        </div>
      </section>
    )
  }

  {
    isCity && video && (
      <section class="section">
        <div class="wrap">
          <SectionHead title={s.video} />
          <div class="vid"><VideoTile video={video} large /></div>
        </div>
      </section>
    )
  }

  {
    isCity && (m.lanes?.length ?? 0) > 0 && (
      <section class="section tight">
        <div class="wrap">
          <SectionHead title={s.lanes} />
          <ul class="lanes" data-reveal-group>
            {m.lanes!.map((l) => LANE_TEXT[locale][l]).filter(Boolean).map((l) => (
              <li><h3>{l!.title}</h3><p class="small prose">{l!.body}</p></li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section panel">
    <div class="wrap">
      <SectionHead title={s.howItWorks} lede={s.routing} />
      <TravelFacts locale={locale} airport={m.airport} direct={m.direct} />
      {
        nearby.length > 0 && (
          <p class="routing">
            <span class="small muted">{s.routingCity}:</span>{' '}
            {nearby.map((n, i) => (
              <>
                {i > 0 && ', '}
                {n.href ? <a class="inline" href={n.href}>{n.name}</a> : <span>{n.name}</span>}
              </>
            ))}
          </p>
        )
      }
    </div>
  </section>

  {
    (page.faq?.length ?? 0) > 0 && (
      <section class="section tight">
        <div class="wrap">
          <SectionHead title={s.faq} />
          <Faq items={page.faq!} />
        </div>
      </section>
    )
  }

  <AvailabilityForm
    tan
    heading={s.bookHere(name)}
    lede={s.bookLede}
    locale={locale}
    market={m.key}
    marketName={isCity ? `${name}, ${countryName}` : name}
    prefillCity={isCity ? `${name}, ${countryName}` : countryName}
    currency={currency}
    travel
  />
</Base>

<style>
  .proof { display: flex; flex-direction: column; gap: 10px; max-width: 48em; padding-left: 22px; border-left: 2px solid var(--tan); }
  .kicker { letter-spacing: .04em; text-transform: uppercase; font-size: 12px; }
  .proofline { font-family: var(--serif); font-size: clamp(22px, 2.4vw, 30px); line-height: 1.25; color: var(--bone); }

  .cards { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); }
  .card { display: flex; justify-content: space-between; align-items: center; height: 100%; padding: clamp(20px, 2.4vw, 28px); background: var(--ink); }
  .card b { font-family: var(--serif); font-size: 24px; font-weight: 600; color: var(--bone); }
  a.card:hover b { color: var(--tan); }
  .note { margin-top: 20px; max-width: 44em; }

  .vid { max-width: 980px; }

  .lanes { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .lanes li { border-top: 1px solid var(--tan); padding-top: 16px; display: flex; flex-direction: column; gap: 8px; }
  .lanes h3 { font-size: 22px; }

  .routing { margin-top: 22px; }
  .inline { color: var(--tan); text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 820px) {
    .cards, .lanes { grid-template-columns: 1fr; }
  }
</style>
