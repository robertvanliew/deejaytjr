# Booking form (/api/lead). With none of these set, the endpoint runs in
# dev mode: it validates, logs the full payload, and returns success —
# so the whole flow is testable before credentials exist.

# Formspree — the simplest route to a real inbox, and the only one of these
# that needs no domain verification. The DESTINATION ADDRESS IS NOT SET HERE:
# it is whatever address the form is registered to in the Formspree dashboard.
# To change who receives leads, change it there, not in this file.
# Endpoint URL from the Formspree dashboard. Left blank on purpose: anyone
# holding it can POST to the form, so it belongs in the deployment's
# environment variables, not in a file that travels with the code.
FORMSPREE_ENDPOINT=

# Resend — optional, and independent of Formspree. Needed only for the branded
# notification and the automatic acknowledgement sent back to the enquirer.
# Requires a verified sending domain.
RESEND_API_KEY=
LEAD_TO_EMAIL=mgmt@deejaytjr.com
LEAD_FROM_EMAIL=bookings@deejaytjr.com

AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

PUBLIC_GA4_ID=

# Audience tracking (npm run audience -- --youtube-auto)
# A plain API key from console.cloud.google.com with "YouTube Data API v3"
# enabled. Not OAuth: nothing to log into, nothing that expires.
YOUTUBE_API_KEY=
YOUTUBE_HANDLE=deejaytjr
